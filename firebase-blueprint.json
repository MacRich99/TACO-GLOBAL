{
  "entities": {
    "users": {
      "title": "Users",
      "description": "System accounts for Clients, Admins, Team Members, and Ambassadors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "full_name": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "admin", "team_member", "ambassador"] },
        "organization": { "type": "string" },
        "phone": { "type": "string" },
        "avatar_url": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "full_name", "role", "created_at"]
    },
    "services": {
      "title": "Services",
      "description": "Platform service catalog with live pricing and availability",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "starting_price": { "type": "number" },
        "currency": { "type": "string" },
        "turnaround_time": { "type": "string" },
        "deliverables": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "category", "title", "starting_price", "turnaround_time", "active"]
    },
    "projects": {
      "title": "Projects",
      "description": "Client commission pipeline, tracking, briefs, deliverables and payment links",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "client_id": { "type": "string" },
        "client_name": { "type": "string" },
        "client_email": { "type": "string" },
        "service_id": { "type": "string" },
        "service_title": { "type": "string" },
        "title": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["Pending Quote", "In Progress", "Under Review", "Completed"] 
        },
        "quote_amount": { "type": "number" },
        "currency": { "type": "string" },
        "payment_status": { "type": "string", "enum": ["unpaid", "deposit_paid", "paid"] },
        "payment_link": { "type": "string" },
        "invoice_pdf_url": { "type": "string" },
        "assigned_to": { "type": "string" },
        "brief_data": { "type": "object" },
        "files_url": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" },
              "size": { "type": "number" },
              "uploaded_at": { "type": "string" }
            }
          } 
        },
        "deliverables_url": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string" },
              "created_at": { "type": "string" }
            }
          }
        },
        "timeline_milestones": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "stage": { "type": "string" },
              "status": { "type": "string", "enum": ["completed", "current", "upcoming"] },
              "date": { "type": "string" },
              "description": { "type": "string" }
            }
          } 
        },
        "communication_logs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sender": { "type": "string" },
              "role": { "type": "string" },
              "message": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "client_id", "title", "status", "created_at"]
    },
    "applications": {
      "title": "Applications",
      "description": "Opportunities pipeline for Campus Ambassadors, Referral Partners, and Specialists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "applicant_name": { "type": "string" },
        "applicant_email": { "type": "string" },
        "phone": { "type": "string" },
        "program_type": { 
          "type": "string", 
          "enum": ["Campus Ambassador", "Referral Partner", "Specialist Talent Network", "Media Partner"] 
        },
        "status": { 
          "type": "string", 
          "enum": ["Received", "Screened", "Approved", "Rejected"] 
        },
        "details": { "type": "object" },
        "notes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "applicant_name", "applicant_email", "program_type", "status", "created_at"]
    }
  }
}
